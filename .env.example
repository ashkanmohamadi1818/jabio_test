# Jabio Server Configuration
PORT=3000
NODE_ENV=development
SITE_URL=http://localhost:3000

# SMTP Email Delivery (Verification & Password Reset Codes)
# Leave blank in local/preview environments to display a safe test code preview.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Jabio <no-reply@jabio.ir>

# SMS Gateway Delivery (Phone Login Verification & SMS Password Reset)
# Supports Kavenegar API key or generic JSON webhook URL
SMS_PROVIDER=kavenegar
SMS_API_KEY=
SMS_SENDER=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
